# ── ResumeIQ AI — Backend Environment Variables ──────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# Database URL
# Default: SQLite (local dev)
# Production: use PostgreSQL
DATABASE_URL=sqlite:///./resumeiq.db
# DATABASE_URL=postgresql://user:password@localhost:5432/resumeiq

# JWT Secret Key — CHANGE THIS in production!
SECRET_KEY=your-super-secret-key-change-in-production

# AI Semantic Mode
# "fast" = TF-IDF cosine similarity (default, no GPU needed)
# "sbert" = sentence-transformers SBERT (better accuracy, needs more RAM)
RESUMEIQ_SEMANTIC_MODE=fast
